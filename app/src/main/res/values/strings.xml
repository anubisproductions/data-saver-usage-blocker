    <string name="app_name">Data Saver</string>

    <!-- Onboarding -->
    <string name="onboard_title">One permission, then you\'re done</string>
    <string name="onboard_body">Android keeps per-app data figures behind a setting called Usage access. Without it this app cannot see which apps are spending your data.\n\nIt reads counters that are already on your phone. Nothing is uploaded — this app has no internet permission at all.\n\nWhen you switch blocking on, Android will say this device is connected to the internet through Data Saver, and show a key icon. That is Android\'s fixed wording for the local filtering it uses, and every app of this kind gets it. Nothing is routed anywhere — the permission list has no internet permission to route it with.</string>
    <string name="onboard_button">Grant Usage access</string>
    <string name="onboard_hint">Find “Data Saver” in the list and turn it on, then come back.</string>

